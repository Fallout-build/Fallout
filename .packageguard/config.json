{
    // Generated by "packageguard init" from the licenses found in this repository.
    // Preset: oss-friendly
    //
    // Copyleft licenses require you to share source code under some conditions. Weak
    // copyleft (e.g. LGPL, MPL) only affects the licensed component itself. Strong
    // copyleft (e.g. GPL) can require your own code to be released under the same
    // license. Network copyleft (AGPL) extends that requirement to software offered
    // as a network service, which matters most for SaaS products.
    //
    // Review this list and adjust it to match your policy, then run "packageguard ."
    // to see which packages, if any, violate it. To adopt the policy gradually, add
    // --treat-deny-as-warning so violations are reported without failing the build.
    "settings": {
        // Only these licenses are allowed. Everything else is a violation.
        "allow": {
            "licenses": [
                "MIT",
                "Apache-2.0",
                "BSD-2-Clause",
                "BSD-3-Clause",
                "ISC",
                "0BSD",
                "MS-PL"
            ],
            // FluentAssertions and NetArchTest.Rules are MIT-licensed but don't publish a
            // license expression/URL NuGet metadata can pick up. See #659.
            "packages": [
                "FluentAssertions",
                "NetArchTest.Rules"
            ]
        },
        // Risk gates. Setting any of these makes PackageGuard collect risk data on every run,
        // which is slower and works best with a GitHub API key. See the risk metrics docs.
        "deny": {
            // Deny packages in the High risk zone (overall score is 0-100).
            "maxOverallRisk": 60,
            // Deny packages whose security risk (0-10) or worst known vulnerability (CVSS) is high.
            "maxSecurityRisk": 7,
            "maxOsvSeverityScore": 7.0,
            "denyDeprecated": true,
            // Deny versions published too recently, a cheap defence against a malicious release.
            "minPackageAgeDays": { "npm": 14, "nuget": 3 }
        },

        // Microsoft.Build.Tasks.Core scores 66.6 overall risk, above the maximum of 60.
        // It is Microsoft's own MSBuild package and compile-time only. The exception does not
        // cover license rules.
        "riskExceptions": [
            {
                "package": "Microsoft.Build.Tasks.Core",
                "reason": "Official Microsoft MSBuild package, compile-time only; score is driven by repository activity metrics",
                "expiresOn": "2027-04-01"
            }
        ]
    }
}
