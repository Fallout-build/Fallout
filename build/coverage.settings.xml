<?xml version="1.0" encoding="utf-8"?>
<!-- Limits code coverage to the Fallout product assemblies. Test and build assemblies are not instrumented. -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*Fallout\..*\.dll$</ModulePath>
      </Include>
      <Exclude>
        <ModulePath>.*Specs.*\.dll$</ModulePath>
        <ModulePath>.*_build.*</ModulePath>
      </Exclude>
    </ModulePaths>
  </CodeCoverage>
</Configuration>
